[Unit]
Description=HW Watcher: lightweight hardware telemetry daemon (NVML, RAPL, hwmon, BAR0, meminfo)
After=dbus.service nvidia-persistenced.service

[Service]
Type=dbus
BusName=io.github.abnermsaconi.HwWatcher
ExecStart=/usr/local/bin/hw-watcher daemon
Restart=on-failure
RestartSec=5

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
Alias=dbus-io.github.abnermsaconi.HwWatcher.service
